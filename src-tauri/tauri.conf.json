{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Knowly",
  "version": "1.0.0",
  "identifier": "com.FrxdWasHere.knowly",
  "build": {
    "frontendDist": "frontend",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Knowly",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "url": "about:blank"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/knowly-node"
    ],
    "resources": {
      "../.output/server": ".output/server",
      "../.output/public": ".output/public"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}